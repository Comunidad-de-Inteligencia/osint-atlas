{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "resolutions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "after_sha256",
          "review_url"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "review_url": {
            "type": "string",
            "pattern": "^https://github.com/P3M-ACTF/osint-atlas/pull/[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
